    <string name="help_title">Help &amp; compatibility</string>
    <string name="help_works_title">What works</string>
    <string name="help_works_body">Standard UVC USB endoscopes over Android OTG. The app tests 720p MJPEG, 480p MJPEG, then 480p YUYV.</string>
    <string name="help_dual_lens_title">Dual-lens cameras</string>
    <string name="help_dual_lens_body">Lens appears only when Android exposes separate USB video devices. If your cable has a lens button, use that button; proprietary switching cannot be guaranteed.</string>
    <string name="help_privacy_title">Privacy</string>
    <string name="help_privacy_body">No account, ads, analytics, cloud upload, location, microphone, or phone-camera access. Captures stay in this app’s local folder until you share them.</string>
    <string name="help_safety_title">Safety</string>
    <string name="help_safety_body">For general inspection only. This is not a medical device and must not be used on people or animals.</string>

